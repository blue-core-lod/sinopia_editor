{
  "name": "sinopia_editor",
  "description": "Editor for BIBFRAME data forked from http://github.com/lcnetdev/bfe",
  "keywords": [
    "bibframe",
    "editor",
    "rdf"
  ],
  "version": "0.24.1",
  "homepage": "http://github.com/LD4P/sinopia_editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LD4P/sinopia_editor.git"
  },
  "engines": {
    "node": ">= 24.4.0"
  },
  "contributors": [
    "Kirk Hess <khes@loc.gov>",
    "Jeremy Nelson <jpnelson@stanford.edu>",
    "Joshua Greben",
    "Naomi Dushay",
    "Sarav Shah",
    "Johnathan Martin",
    "Michael Giarlo",
    "Justin Coyne",
    "Peter Mangiafico",
    "Justin Littman",
    "Aaron Collier",
    "Huda Khan"
  ],
  "bugs": {
    "url": "http://github.com/LD4P/sinopia_editor/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "webpack --progress --mode production",
    "dev-build": "webpack --progress --mode development",
    "dev-build-test": "npm run dev-build && npm run test",
    "dev-start": "webpack-dev-server --config ./webpack.config.js --mode development",
    "eslint": "eslint --color --max-warnings 0 .",
    "eslint-fix": "eslint --color --fix .",
    "eslint-fix-single": "eslint --color --fix",
    "pretty": "NODE_OPTIONS='--no-experimental-webstorage' prettier --check .",
    "pretty-fix": "NODE_OPTIONS='--no-experimental-webstorage' prettier --write .",
    "fix": "npm run pretty-fix && npm run eslint-fix",
    "lint": "npm run pretty && npm run eslint",
    "start": "npx babel-node server.js",
    "test": "jest --colors --silent --runInBand --logHeapUsage",
    "test-verbose": "jest --colors --runInBand"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@honeybadger-io/react": "^6.1.36",
    "@popperjs/core": "^2.10.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@rdfjs/serializer-jsonld-ext": "^4.0.2",
    "assert": "^2.0.0",
    "bootstrap": "^5.1.1",
    "buffer": "^6.0.3",
    "concat-stream": "^2.0.0",
    "cors": "^2.8.5",
    "crypto-browserify": "^3.12.0",
    "crypto-js": "^4.1.1",
    "date-and-time": "^2.0.1",
    "dotenv": "^8.6.0",
    "edtf": "^3.1.0",
    "event-stream": "^4.0.1",
    "express": "^4.16.4",
    "express-http-proxy": "^1.6.3",
    "file-saver": "^2.0.5",
    "html-webpack-plugin": "^5.3.2",
    "identity-obj-proxy": "^3.0.0",
    "javascript-time-ago": "^2.3.9",
    "jsonld-streaming-parser": "^2.4.0",
    "keycloak-js": "^26.2.0",
    "language-subtag-registry": "^0.4.2",
    "lodash": "^4.17.21",
    "merge": "^2.1.1",
    "mixin-deep": ">=1.3.2",
    "n3": "^1.11.1",
    "nanoid": "^3.1.25",
    "process": "^0.11.10",
    "randexp": "^0.5.3",
    "rdf-ext": "^1.3.5",
    "react": "^19.3.0",
    "react-bootstrap-icons": "^1.5.0",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-dom": "^19.3.0",
    "react-focus-lock": "^2.12.1",
    "react-helmet-async": "^3.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "react-textarea-autosize": "^8.5.9",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "stream-browserify": "^3.0.0",
    "uuid": "^14.0.2",
    "vm-browserify": "^1.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/node": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@fetch-mock/jest": "^0.2.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.3.4",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-webpack": "^0.13.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "history": "^5.3.0",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-localstorage-mock": "^2.4.17",
    "jest-mock-console": "^2.0.0",
    "jest-prop-type-error": "^1.1.0",
    "jest-summarizing-reporter": "^1.1.4",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.9",
    "raw-loader": "^4.0.2",
    "redux-mock-store": "^1.5.3",
    "sass": "^1.54.8",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "supertest": "^7.2.2",
    "timezone-mock": "^1.4.3",
    "webpack": "^5.52.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "jest": {
    "automock": false,
    "resetMocks": false,
    "setupFilesAfterEnv": [
      "<rootDir>/react-testing-library.setup.js",
      "<rootDir>/__tests__/matchers/templates.js",
      "<rootDir>/__tests__/matchers/resources.js",
      "<rootDir>/__tests__/matchers/actions.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "src",
      "__tests__/testUtilities"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|scss|sass|less)$": "identity-obj-proxy",
      "^@digitalbazaar/http-client$": "<rootDir>/__mocks__/@digitalbazaar/http-client.js"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "src/**/*.jsx",
      "!src/index.js"
    ],
    "setupFiles": [
      "./__tests__/testUtilities/setupNodeGlobals.js",
      "jest-localstorage-mock",
      "jest-prop-type-error",
      "dotenv/config"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node"
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "collectCoverage": true,
    "coverageReporters": [
      "lcov"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(@rdfjs/(serializer-jsonld-ext|sink)|stream-chunks)/)"
    ],
    "reporters": [
      [
        "jest-summarizing-reporter",
        {
          "diffs": true
        }
      ]
    ]
  },
  "main": "",
  "author": ""
}
